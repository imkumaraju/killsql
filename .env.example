# Supabase (required for auth, submissions, profile, leaderboard)
# Create a project at https://supabase.com then paste values here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used by the hourly streak cron (freeze consume / break)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# Public site URL (OAuth redirect and Stripe return URLs). Local default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (optional — donate prompt still appears; checkout needs this key)
# Create a key at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
