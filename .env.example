# Supabase (required for auth, submissions, profile, leaderboard)
# Project: KillSQL  https://pbsrivwuhq2thtgut.supabase.co
# Copy this file to apps/web/.env.local and fill keys from
# Project Settings → API. Schema is applied by GitHub Actions, not the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://pbsrivwuhq2thtgut.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used by the hourly streak cron (freeze consume / break)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# Public site URL (OAuth redirect and Dodo Payments return URLs). Local default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth is enabled in the Supabase dashboard (Authentication → Providers → Google),
# not via extra Next.js env vars. Redirect URI:
#   https://<project-ref>.supabase.co/auth/v1/callback

# Dodo Payments (optional — donate prompt still appears; checkout needs these)
# Dashboard: https://app.dodopayments.com  → Developer → API Keys (Test mode)
# Create a one-time USD product with Pay What You Want enabled (min $1).
DODO_PAYMENTS_API_KEY=your_test_api_key
DODO_PAYMENTS_PRODUCT_ID=pdt_your_donation_product
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
